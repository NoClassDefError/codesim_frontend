{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SPICE (CodeSim)",
  "scopeName": "source.spice.codesim",
  "fileTypes": ["cir"],
  "patterns": [
    { "include": "#title" },
    { "include": "#comments" },
    { "include": "#continuation" },
    { "include": "#cards" },
    { "include": "#elements" },
    { "include": "#body" }
  ],
  "repository": {
    "title": {
      "comment": "SPICE rule: the first line of a netlist is always its title.",
      "match": "\\A.*$",
      "name": "markup.heading.title.spice"
    },
    "comments": {
      "patterns": [
        { "match": "^\\s*\\*.*$", "name": "comment.line.asterisk.spice" },
        { "match": ";.*$", "name": "comment.line.semicolon.spice" },
        { "match": "(?<=\\s)\\$\\s.*$", "name": "comment.line.dollar.spice" }
      ]
    },
    "continuation": {
      "match": "^\\s*(\\+)",
      "captures": { "1": { "name": "punctuation.separator.continuation.spice" } }
    },
    "cards": {
      "patterns": [
        {
          "comment": "File name after .include / .lib / .hdl (.lib file [section]).",
          "match": "^\\s*(\\.(?i:include|inc|lib|hdl))\\s+(\\S+)(?:\\s+(\\w+))?",
          "captures": {
            "1": { "name": "keyword.control.import.spice" },
            "2": { "name": "string.unquoted.path.spice" },
            "3": { "name": "entity.name.section.spice" }
          }
        },
        {
          "match": "^\\s*(\\.(?i:title))\\b(.*)$",
          "captures": {
            "1": { "name": "keyword.control.card.spice" },
            "2": { "name": "markup.heading.title.spice" }
          }
        },
        {
          "comment": ".meas [tran] <name> ...: the measure name; the WHEN event name is also the event time in PWL knots.",
          "match": "^\\s*(\\.(?i:meas|measure))\\s+(?:((?i:tran|ac|dc|noise|op))\\s+)?(\\w+)",
          "captures": {
            "1": { "name": "keyword.control.card.spice" },
            "2": { "name": "keyword.other.analysis.spice" },
            "3": { "name": "entity.name.function.measure.spice" }
          }
        },
        {
          "comment": ".model / .subckt / .ends / .func and the name they define.",
          "match": "^\\s*(\\.(?i:model|subckt|ends|func))\\s+(\\w+)",
          "captures": {
            "1": { "name": "keyword.control.card.spice" },
            "2": { "name": "entity.name.type.model.spice" }
          }
        },
        {
          "match": "^\\s*(\\.(?i:options|option|opt|param|params|tran|probe|save|global|endl|ends|end))\\b",
          "captures": { "1": { "name": "keyword.control.card.spice" } }
        },
        {
          "comment": "LTspice cards CodeSim skips with a warning.",
          "match": "^\\s*(\\.(?i:ac|dc|noise|tf|four|op|step|temp|wave|backanno|net|fra|ic|nodeset|savestate|loadstate|savebias|text|machine|endmachine))\\b",
          "captures": { "1": { "name": "invalid.deprecated.ignored-card.spice" } }
        },
        {
          "comment": "Other SPICE cards are not supported by CodeSim.",
          "match": "^\\s*(\\.\\w+)",
          "captures": { "1": { "name": "invalid.illegal.unsupported-card.spice" } }
        }
      ]
    },
    "elements": {
      "patterns": [
        {
          "comment": "Xname node+ node- Model: a CodeSim device, .model or .subckt.",
          "match": "^\\s*([Xx][\\w:]*)\\s+([^\\s=]+)\\s+([^\\s=]+)\\s+([\\w.]+)(?!\\s*=)",
          "captures": {
            "1": { "name": "entity.name.tag.device.spice" },
            "2": { "name": "variable.other.node.spice" },
            "3": { "name": "variable.other.node.spice" },
            "4": { "name": "entity.name.type.model.spice" }
          }
        },
        {
          "comment": "Rname / Lname / Cname node1 node2 value.",
          "match": "^\\s*([RrLlCc][\\w:]*)\\s+([^\\s=]+)\\s+([^\\s=]+)",
          "captures": {
            "1": { "name": "entity.name.tag.passive.spice" },
            "2": { "name": "variable.other.node.spice" },
            "3": { "name": "variable.other.node.spice" }
          }
        },
        {
          "comment": "Element letters CodeSim does not support.",
          "match": "^\\s*([A-WYZa-wyz][\\w:]*)(?=\\s)",
          "captures": { "1": { "name": "invalid.illegal.unsupported-element.spice" } }
        }
      ]
    },
    "body": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#braceExpression" },
        { "include": "#quotedExpression" },
        {
          "match": "\\b((?i:params:|ako:|when|rise|fall|cross|from|to|tran|uic|find|deriv|at|avg|max|min|pp|rms|integ|trig|targ|val|td|last|param))(?=[\\s=]|$)",
          "captures": { "1": { "name": "keyword.other.spice" } }
        },
        {
          "match": "\\b([A-Za-z_]\\w*)\\s*(?==)",
          "captures": { "1": { "name": "variable.parameter.name.spice" } }
        },
        { "include": "#expression" }
      ]
    },
    "braceExpression": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.spice" } },
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.spice" } },
      "name": "meta.embedded.expression.spice",
      "patterns": [{ "include": "#expression" }]
    },
    "quotedExpression": {
      "comment": "HSPICE: 'expr' is an expression.",
      "begin": "'",
      "end": "'",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.spice" } },
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.spice" } },
      "name": "meta.embedded.expression.spice",
      "patterns": [{ "include": "#expression" }]
    },
    "expression": {
      "patterns": [
        { "include": "#braceExpression" },
        {
          "comment": "ngspice device internal: @xname[state].",
          "match": "(@)([\\w:]+)(\\[)\\s*(\\w+)\\s*(\\])",
          "captures": {
            "1": { "name": "punctuation.definition.variable.spice" },
            "2": { "name": "entity.name.tag.device.spice" },
            "3": { "name": "punctuation.section.brackets.begin.spice" },
            "4": { "name": "variable.other.member.state.spice" },
            "5": { "name": "punctuation.section.brackets.end.spice" }
          }
        },
        {
          "comment": "Output functions: V(n) V(n1,n2) VM(n) VP(n) I(R|L) IM(R|L) P(n) Q(n).",
          "match": "\\b((?i:vm|vp|v|im|i|p|q))\\s*(\\()\\s*([\\w.:+-]+)\\s*(?:(,)\\s*([\\w.:+-]+)\\s*)?(\\))",
          "captures": {
            "1": { "name": "support.function.output.spice" },
            "2": { "name": "punctuation.section.parens.begin.spice" },
            "3": { "name": "variable.other.node.spice" },
            "4": { "name": "punctuation.separator.spice" },
            "5": { "name": "variable.other.node.spice" },
            "6": { "name": "punctuation.section.parens.end.spice" }
          }
        },
        {
          "match": "\\b((?i:pwl|par|sqrt|exp|ln|log10|log|sinh|cosh|tanh|asin|acos|atan2|atan|sin|cos|tan|abs|min|max|pow|pwrs|pwr|hypot|cbrt|limit|if|uramp|u|sgn|floor|ceil|int|round|mod|buf|inv|xor|table|wrap))(?=\\s*\\()",
          "captures": { "1": { "name": "support.function.spice" } }
        },
        { "match": "\\b(?i:pi|time|boltz|echarge|planck|kelvin|gmin)\\b", "name": "constant.language.spice" },
        {
          "comment": "Numbers with an engineering suffix (f p n u m k meg mil g t), also as a decimal point (6k34), and optional unit letters.",
          "match": "(?<![\\w.])((?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][+-]?\\d+)?)((?i:meg|mil|[fpnumkgt])?(?:\\d+|[A-Za-z]*))",
          "captures": {
            "1": { "name": "constant.numeric.spice" },
            "2": { "name": "keyword.other.unit.suffix.spice" }
          }
        },
        { "match": "\\*\\*|==|!=|<=|>=|&&|\\|\\||[-+*/^%<>!~&|?:]", "name": "keyword.operator.spice" },
        { "match": "=", "name": "keyword.operator.assignment.spice" }
      ]
    }
  }
}
